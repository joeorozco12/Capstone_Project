# Backend service environment template
# Copy to `backend/.env.local`, `backend/.env.staging`, or
# `backend/.env.production` and fill with deployment-specific values.

APP_ENV=local
PORT=8000
API_BASE_URL=http://localhost:8000/api

# MQTT / broker connectivity
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=backend-service
MQTT_USERNAME=
MQTT_PASSWORD=

# Auth / secrets
AUTH_JWT_SECRET=replace-with-strong-jwt-secret
AUTH_REFRESH_SECRET=replace-with-strong-refresh-secret
SESSION_SECRET=replace-with-strong-session-secret

# Device registration flow
DEVICE_REGISTRATION_MODE=manual
DEVICE_ID_PREFIX=feeder-
DEVICE_PROVISIONING_TOKEN=
ALLOW_UNREGISTERED_DEVICES=false

# Feature flags
FEATURE_ENABLE_MQTT=true
FEATURE_ENABLE_DEVICE_PROVISIONING=true
FEATURE_ENABLE_PUSH_NOTIFICATIONS=false

# Logging / observability
LOG_LEVEL=debug
