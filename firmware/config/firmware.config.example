# Firmware configuration template
# Copy to a board-specific config file before flashing.

APP_ENV=local
API_BASE_URL=http://192.168.1.100:8000/api
MQTT_BROKER_HOST=192.168.1.100
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=feeder-firmware-001
MQTT_USERNAME=
MQTT_PASSWORD=

# Security / auth
AUTH_DEVICE_SECRET=replace-with-device-secret
DEVICE_PROVISIONING_TOKEN=

# Device identity / registration
DEVICE_REGISTRATION_MODE=manual
DEVICE_ID=feeder-dev-001
DEVICE_ID_PREFIX=feeder-

# Feature flags
FEATURE_ENABLE_MQTT=true
FEATURE_ENABLE_PID=false
FEATURE_ENABLE_LOAD_CELL=true
FEATURE_ENABLE_REMOTE_COMMANDS=true

# Diagnostics
LOG_LEVEL=debug
