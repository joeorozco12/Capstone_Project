# Android local properties template
# Copy to `android-app/local.properties` and customize per developer machine.

sdk.dir=/path/to/Android/Sdk
APP_ENV=local
API_BASE_URL=http://10.0.2.2:8000/api
MQTT_BROKER_HOST=10.0.2.2
MQTT_BROKER_PORT=1883
FEATURE_ENABLE_REMOTE_FEEDING=true
FEATURE_ENABLE_TELEMETRY=true
LOG_LEVEL=debug
# Prefer a registration flow token rather than hardcoding device IDs in-app.
DEVICE_REGISTRATION_MODE=manual
# DEVICE_DEFAULT_ID=feeder-dev-001
# DEVICE_PROVISIONING_TOKEN=
